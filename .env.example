# Copy to .env and adjust. The app runs fine with NONE of these set (DB-less);
# set DATABASE_URL to enable persistence, history, monitors and alerts.

# --- Database (optional) ---
# With DATABASE_URL set the server migrates the schema itself at startup (no
# separate "npm run db:migrate" needed) and then saves everything: every
# check, API keys, share links and visitor records. GET /api/health reports
# db "ok" / "error" (with the reason) / "off".
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/blacklist
#
# Supabase: copy the EXACT connection string from your project's "Connect"
# dialog (dashboard top bar). Use the SESSION POOLER one (port 5432, IPv4):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_SSL=true
# Do NOT paste the dashboard page URL here; that is a web page, not a database
# address. If TLS verification fails, download the CA from Project Settings ->
# Database -> SSL and set DATABASE_CA=./supabase-ca.crt
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false            # true = require TLS (certificate IS verified)
# DATABASE_CA=/path/to/ca.pem   # CA bundle for a private CA
# DATABASE_SSL_INSECURE=false   # true DISABLES cert verification (avoid; MITM risk)

# --- Dashboard login ---
# Two fixed accounts, roles admin and user. Defaults: admin / pass-@admin and
# user / pass@user. CHANGE THEM before exposing the tool to the internet:
# DBC_ADMIN_USER=admin
# DBC_ADMIN_PASS=change-this-password
# DBC_USER_USER=user
# DBC_USER_PASS=change-this-too
# DBC_SESSION_TTL_HOURS=24      # how long a login lasts
# DBC_COOKIE_SECURE=true        # set when served over HTTPS
# DBC_LOGIN_DISABLED=true       # turns the login OFF (old open mode)

# --- DNS resolver (IMPORTANT in production) ---
# Point at your own recursive resolver (Unbound). Public resolvers like
# 8.8.8.8 / 1.1.1.1 are refused by Spamhaus/URIBL and their answers are dropped
# by calibration (see ACCURACY.md).
# DBC_RESOLVERS=127.0.0.1

# --- Spamhaus DQS key (free) — the best accuracy upgrade ---
# With a key, Spamhaus ZEN + DBL work from ANY network (no own resolver needed).
# Get one at https://www.spamhaus.com/free-trial/ then set it here.
# The key is secret: it is only used to build the DNS query, never exposed.
# DBC_DQS_KEY=your26characterkeyfromspamhaus

# --- Behind a reverse proxy / PaaS (Render, Railway, Fly, nginx) ---
# DBC_TRUST_PROXY=true

# --- Server ---
# PORT=3000
# HOST=0.0.0.0
# DBC_TRUST_PROXY=false   # true only when behind a known reverse proxy (for req.ip)
# DBC_CACHE_MAX=5000      # max cached domains (bounds memory)

# --- Cache / rate limit / bulk ---
# DBC_CACHE_TTL_MS=900000
# DBC_RATE_MAX=30
# DBC_RATE_WINDOW_MS=60000
# DBC_BULK_MAX=500
# DBC_BULK_CONCURRENCY=5
