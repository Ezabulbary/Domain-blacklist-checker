# Copy to .env and adjust. The app runs fine with NONE of these set (DB-less);
# set DATABASE_URL to enable persistence, history, monitors and alerts.

# --- Database (optional) ---
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/blacklist
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false            # true = require TLS (certificate IS verified)
# DATABASE_CA=/path/to/ca.pem   # CA bundle for a private CA
# DATABASE_SSL_INSECURE=false   # true DISABLES cert verification (avoid; MITM risk)

# --- DNS resolver (IMPORTANT in production) ---
# Point at your own recursive resolver (Unbound). Public resolvers like
# 8.8.8.8 / 1.1.1.1 are refused by Spamhaus/URIBL and their answers are dropped
# by calibration (see ACCURACY.md).
# DBC_RESOLVERS=127.0.0.1

# --- Spamhaus DQS key (free), the best accuracy upgrade ---
# With a key, Spamhaus ZEN + DBL work from ANY network (no own resolver needed).
# How to get one (free, ~2 minutes):
#   1. Sign up at https://www.spamhaus.com/free-trial/  (the "Data Query Service")
#   2. Open the DQS portal -> your key is a 26-char string
#   3. Paste it below. That's it; ZEN + DBL start answering immediately.
# The key is secret: it is only used to build the DNS query, never exposed in the
# API or UI. A wrong/expired key is caught by calibration (shown as "blocked").
# DBC_DQS_KEY=your26characterkeyfromspamhaus
#
# Optional: also query ZRD (Zero Reputation Domains): brand-new / no-history
# domains. Useful for cold-email domain vetting. A new domain is a risk signal,
# NOT proof of spam, so it is opt-in and weighted as a medium signal.
# DBC_DQS_ZRD=true

# --- Behind a reverse proxy / PaaS (Render, Railway, Fly, nginx) ---
# DBC_TRUST_PROXY=true

# --- Server ---
# PORT=3000
# HOST=0.0.0.0
# DBC_TRUST_PROXY=false   # true only when behind a known reverse proxy (for req.ip)
# DBC_CACHE_MAX=5000      # max cached domains (bounds memory)

# --- Cache / rate limit / bulk ---
# DBC_CACHE_TTL_MS=900000
# DBC_RATE_MAX=30
# DBC_RATE_WINDOW_MS=60000
# DBC_BULK_MAX=500
# DBC_BULK_CONCURRENCY=5
